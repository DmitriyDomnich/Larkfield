POSTGRES_USER=larkfield
POSTGRES_PASSWORD=test12345
POSTGRES_DB=larkfield

# used when running the API or tests on the host(not in Docker), points at the compose db.
DATABASE_URL=postgresql://larkfield:test12345@localhost:5432/larkfield
APP_ENV=local
LOG_LEVEL=INFO

COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=<user_pool_id>
COGNITO_APP_CLIENT_ID=<app_client_id>
AWS_PROFILE=<aws_profile>
