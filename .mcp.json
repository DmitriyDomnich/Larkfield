{
  "mcpServers": {
    "postgres": {
      "command": "sh",
      "args": [".claude/mcp/postgres.sh"]
    },
    "aws-docs": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@1.2.4"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "strands-docs": {
      "command": "uvx",
      "args": ["strands-agents-mcp-server"]
    },
    "larkfield-review": {
      "command": "uv",
      "args": ["run", "--env-file", ".env", "python", "-m", "app.review.mcp_server"]
    }
  }
}
